.battle-button {
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    align-self: auto;
    margin-left: 10px;
    transition-duration: 0.2s;
    background-image: none;
}

.battle-button-s {
    -unity-background-image-tint-color: rgb(0, 203, 255);
}

.battle-button:hover {
    scale: 1.1 1.1;
}

.battlepage-card-bg {
    width: 160px;
    height: 160px;
    background-color: rgb(26, 26, 26);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-duration: 0.2s;
    background-image: none;
}

.battlepage-card-bg-s {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(75, 207, 255);
    border-right-color: rgb(75, 207, 255);
    border-top-color: rgb(75, 207, 255);
    border-bottom-color: rgb(75, 207, 255);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}

.battlepage-card-bg:hover {
    scale: 1.1 1.1;
}
